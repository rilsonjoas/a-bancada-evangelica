{
  "name": "a-bancada-evangelica",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8080",
    "dev:api": "node api-server.cjs",
    "dev:full": "concurrently \"pnpm dev\" \"pnpm dev:api\"",
    "start": "NODE_ENV=production node api-server.cjs",
    "docs:sync-public": "mkdir -p public/docs && cp docs/REPRODUCIBILITY.md public/docs/REPRODUCIBILITY.md",
    "prebuild": "pnpm docs:sync-public",
    "predev": "pnpm docs:sync-public",
    "build": "vite build && tsx scripts/generate-og-pages.ts",
    "build:dev": "vite build --mode development",
    "test": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.api.json --noEmit",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "sync:camara": "tsx scripts/sync-camara.ts",
    "sync:senado": "tsx scripts/sync-senado.ts",
    "sync:camara:gastos": "tsx scripts/sync-all-gastos.ts",
    "sync:camara:recheck": "tsx scripts/sync-votes.ts",
    "sync:senado:gastos": "tsx scripts/sync-senado.ts gastos",
    "sync:worker": "tsx scripts/sync-worker.ts",
    "sync:worker:list": "tsx scripts/sync-worker.ts list",
    "analyze:expenses": "tsx scripts/expense-analyzer.ts",
    "check:progress": "tsx scripts/check-progress.ts",
    "sync:votes": "tsx scripts/sync-votes.ts",
    "scores:recalculate": "tsx scripts/recalculate-scores.ts",
    "quality:check": "tsx scripts/quality-check.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "scores:seed": "tsx scripts/seed-party-scores.ts",
    "sync:fpe": "tsx scripts/sync-fpe-members.ts",
    "sync:tse:candidatura": "tsx scripts/sync-tse-candidatura.ts",
    "sync:tse:receitas": "tsx scripts/sync-tse-receitas.ts",
    "sync:news": "tsx scripts/sync-news.ts",
    "seed:fpe:tiers": "tsx scripts/seed-fpe-tiers.ts",
    "seed:practical-impact": "tsx scripts/seed-practical-impact.ts",
    "sync:all": "pnpm sync:camara && pnpm sync:senado && pnpm sync:fpe && pnpm sync:votes && pnpm scores:recalculate",
    "sitemap:generate": "tsx scripts/generate-sitemap.ts"
  },
