# Configurações do banco de dados
DATABASE_URL="postgresql://username:password@localhost:5432/bancada_evangelica?schema=public"

# Configurações de ambiente
NODE_ENV="development"

# URLs das APIs governamentais (já configuradas no código, mas podem ser sobrescritas)
CAMARA_API_URL="https://dadosabertos.camara.leg.br/api/v2"
SENADO_API_URL="https://legis.senado.leg.br/dadosabertos" 
TSE_API_URL="https://dadosabertos.tse.jus.br"

# Configurações de rate limiting (opcional)
CAMARA_RATE_LIMIT="120"  # requests por minuto
SENADO_RATE_LIMIT="60"   # requests por minuto

# Configurações de sincronização
SYNC_ENABLED="true"
SYNC_INTERVAL_HOURS="6"   # Intervalo padrão para sincronização

# Configurações de cache (opcional - para Redis se implementado)
REDIS_URL="redis://localhost:6379"

# Configurações de logs
LOG_LEVEL="info"
LOG_TO_FILE="true"

# Configurações de segurança
JWT_SECRET="seu_jwt_secret_aqui"
ADMIN_PASSWORD="senha_admin_muito_segura"

# Configurações de email (para notificações)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Configurações de webhook (para integrações externas)
WEBHOOK_SECRET=""

# Configurações de backup
BACKUP_ENABLED="true"
BACKUP_SCHEDULE="0 2 * * *"  # Todo dia às 2h

# Configurações específicas para análise
EXPENSE_ANALYSIS_ENABLED="true"
TRANSPARENCY_BONUS_ENABLED="true"

# Configurações de desenvolvimento
DEV_SEED_DATABASE="true"
DEV_MOCK_APIS="false"