# ── Banco de dados (Supabase / Neon / PostgreSQL local) ──────────────────────
DATABASE_URL="postgresql://username:password@host:5432/bancada_evangelica?schema=public"
# DIRECT_URL é necessário para migrações no Supabase (connection pooler não suporta DDL)
DIRECT_URL="postgresql://username:password@host:5432/bancada_evangelica?schema=public"

# ── Backend ───────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3001"
# URL do frontend para configuração de CORS em produção
FRONTEND_URL="http://localhost:8080"

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# URL da API principal (NestJS). Self-hosted no VPS Hetzner desde
# 2026-08-02 (achado 2026-09-08: esta variável ainda dizia "aponte pro
# Railway" — projeto saiu do Railway há mais de um mês, ver README.md
# §Deploy). Produção: https://api-bancada.narniano.com
VITE_API_URL="http://localhost:3001"
# URL do serviço de análise ML (Python/FastAPI), também no VPS Hetzner.
# Produção: https://analise-bancada.narniano.com
VITE_ANALYSIS_URL="http://localhost:8001"

# ── APIs governamentais ───────────────────────────────────────────────────────
CAMARA_API_URL="https://dadosabertos.camara.leg.br/api/v2"
SENADO_API_URL="https://legis.senado.leg.br/dadosabertos"
TSE_API_URL="https://dadosabertos.tse.jus.br"

# Rate limiting (requisições por minuto)
CAMARA_RATE_LIMIT="120"
SENADO_RATE_LIMIT="60"

# ── Sincronização ─────────────────────────────────────────────────────────────
SYNC_ENABLED="true"
SYNC_INTERVAL_HOURS="6"
EXPENSE_ANALYSIS_ENABLED="true"

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL="info"
LOG_TO_FILE="true"

# ── Formulário de contato (2026-08-16) — envio via Resend ────────────────────
# Sem isso, POST /api/contact responde 503 (não trava o resto da API).
RESEND_API_KEY=""
CONTACT_EMAIL_TO="abancada@narniano.com"
CONTACT_EMAIL_FROM="abancada@narniano.com"

# ── Monitoramento de runtime (CEPT2-9) ──────────────────────────────────────
# Sem SENTRY_DSN a integração fica inerte (zero custo). Com o DSN do projeto
# Sentry, os erros 500+ da API são reportados automaticamente.
# SENTRY_DSN=https://<chave>@<org>.ingest.sentry.io/<project>
# SENTRY_RELEASE=<opcional: versão/deploy para agrupar>

# ── Curadoria de notícias (#7, 2026-08-28) ───────────────────────────────────
# Token estático que protege os endpoints admin (fila pendente + aprovar/
# rejeitar). Enviado no header `x-admin-token`. Sem esta variável, a área
# admin responde 503 (fail-closed) — curadoria desligada até alguém configurar.
ADMIN_TOKEN=""

# Métricas de audiência — Umami auto-hospedado, modo COOKIELESS (sem banner
# LGPD; ver src/components/Analytics.tsx para a decisão completa). Sem estas
# variáveis, nenhum script de analytics carrega (hook dormente).
# VITE_UMAMI_SRC=https://umami.narniano.com/script.js
# VITE_UMAMI_ID=<website-id-gerado-no-umami>

# ── Frescor + alerta de falha (Eixo 1, docs/PLANO-OPERACAO-SUSTENTAVEL.md) ──
# Push monitor do Uptime Kuma por job do sync-worker — mesmo padrão já em
# produção em hetzner-infra/backup/backup.sh. Cada variável abaixo é opcional
# e independente: sem ela, o job correspondente simplesmente não reporta
# (nunca quebra o job em si). Criar 1 monitor tipo "Push" por variável no
# Uptime Kuma e colar a URL gerada (formato https://<host>/api/push/<token>).
# UPTIME_KUMA_PUSH_URL_POLITICIANS=
# UPTIME_KUMA_PUSH_URL_NEWS=
# UPTIME_KUMA_PUSH_URL_SCORES=
# UPTIME_KUMA_PUSH_URL_EXPENSES=
# UPTIME_KUMA_PUSH_URL_EXPENSE_ANALYSIS=
# UPTIME_KUMA_PUSH_URL_LOG_CLEANUP=
# Liveness da busca diária de notícias (sempre status=up, com a contagem
# da fila na mensagem). Tamanho de fila NÃO é alerta — decisão 2026-09-27.
# UPTIME_KUMA_PUSH_URL_CURATION_QUEUE=

# ── Capacidade de curadoria (Eixo 2) ─────────────────────────────────────────
# Sem variáveis aqui de propósito: janela (30 dias) e teto por parlamentar (5)
# ficam em scripts/lib/news-curation.ts, com teste. Decisão e números
# medidos em docs/DECISOES.md (2026-09-27). CURATION_QUEUE_ALERT_THRESHOLD e
# CURATION_QUEUE_STALE_DAYS não são mais lidos.
